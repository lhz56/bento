<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime, as Developer ID notarization requires. Only what Electron itself needs:
     JavaScript and WebAssembly (Python runs as WebAssembly) compile code at run time. No camera, microphone,
     contacts or other protected data. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
