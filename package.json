{
  "name": "bento",
  "productName": "Bento",
  "version": "0.2.0",
  "description": "Learn how software is really built, using the AI subscription you already have.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && env -u ELECTRON_RUN_AS_NODE BENTO_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app": "vite build && electron-builder --mac dir",
    "dist": "vite build && electron-builder --mac dmg zip",
    "test": "node test/runtime.test.mjs && node test/atlas.test.mjs"
  },
  "build": {
    "appId": "dev.bento.app",
    "productName": "Bento",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": false,
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "darkModeSupport": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^6.2.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "license": "MIT"
}
