{
  "name": "bento",
  "productName": "Bento",
  "version": "0.3.2",
  "description": "Ask anything, get a lesson you can run. Paste any GitHub repo, get its blueprint. Uses the AI plan you already have.",
  "author": "Bento contributors",
  "homepage": "https://takeitapart.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/lhz56/bento.git"
  },
  "bugs": {
    "url": "https://github.com/lhz56/bento/issues"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && env -u ELECTRON_RUN_AS_NODE BENTO_DEV=1 electron .\"",
    "build": "vite build",
    "build:web": "VITE_BENTO_WEB=1 vite build",
    "start": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app": "vite build && electron-builder --mac dir --publish never -c.mac.identity=null -c.electronFuses.enableNodeCliInspectArguments=true -c.extraMetadata.bentoTestBuild=true",
    "dist": "vite build && electron-builder --mac dmg zip --arm64 --x64 --publish never && node scripts/notarize-dmg.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test": "node test/runtime.test.mjs && node test/atlas.test.mjs && node test/features.test.mjs && node test/host.test.mjs && node test/conventions.test.mjs && node scripts/check-puzzles.mjs",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "release": "node scripts/release.mjs",
    "smoke:web": "npm run build:web && node scripts/smoke-web.mjs",
    "smoke:phone": "vite build && node scripts/smoke-phone.mjs && node scripts/smoke-phone.mjs --ipad",
    "verify-release": "node scripts/verify-mac-release.mjs",
    "preflight": "node scripts/check-release.mjs",
    "smoke": "vite build && node scripts/smoke-app.mjs && node scripts/smoke-tour.mjs && node scripts/smoke-stream.mjs && node scripts/smoke-ais.mjs && node scripts/smoke-guards.mjs && node scripts/smoke-failures.mjs && node scripts/smoke-agent.mjs",
    "audit": "vite build && node scripts/audit-a11y.mjs && node scripts/audit-keyboard.mjs"
  },
  "build": {
    "appId": "dev.bento.app",
    "productName": "Bento",
    "files": [
      "dist/**",
      "electron/**",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en",
      "en-GB",
      "es",
      "es-419",
      "fr",
      "de",
      "it",
      "pt-BR",
      "pt-PT",
      "nl",
      "sv",
      "pl",
      "tr",
      "ru",
      "uk",
      "ar",
      "he",
      "hi",
      "th",
      "vi",
      "id",
      "ms",
      "ja",
      "ko",
      "zh-CN",
      "zh-TW"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lhz56",
        "repo": "bento-releases",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSHumanReadableCopyright": "MIT License"
      }
    },
    "dmg": {
      "title": "${productName} ${version} Installer",
      "artifactName": "${productName}-${arch}.${ext}",
      "sign": true,
      "writeUpdateInfo": false,
      "format": "ULFO",
      "contents": [
        {
          "x": 166,
          "y": 196,
          "type": "file"
        },
        {
          "x": 474,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 640,
        "height": 432
      },
      "iconSize": 120,
      "iconTextSize": 12,
      "background": "build/background.tiff"
    },
    "protocols": [
      {
        "name": "Bento",
        "schemes": [
          "bento"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.39.5",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "pyodide": "^314.0.7",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
